# Copy to .env and fill in. Never commit .env.
# Make tokens with:  python scripts/gen_token.py
# Need at least one token. Each token = one role:
#   admin  = everything, including delete_file
#   writer = read + write + commit, no delete
#   reader = read-only tools
MCP_TOKEN_ADMIN=replace-me-with-a-long-random-string
MCP_TOKEN_WRITER=
MCP_TOKEN_READER=

# Your ngrok static domain, no https://  (example: panda-new-kit.ngrok-free.dev)
PUBLIC_HOST=your-domain.ngrok-free.dev

HOST=127.0.0.1
PORT=8000

# Optional
# WORKSPACE_ROOT=workspace
# AUDIT_LOG=logs/tool_calls.jsonl
# MCP_TRANSPORT=stdio   # only for MCP Inspector testing
